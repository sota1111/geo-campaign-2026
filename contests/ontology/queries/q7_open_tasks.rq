PREFIX c: <https://geo-campaign-2026.example/ontology#>
PREFIX id: <https://geo-campaign-2026.example/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Q7 進捗一覧の残作業（担当つき）。
SELECT ?task ?text ?agentName ?app ?sub ?due (SAMPLE(?source) AS ?firstSource)
WHERE {
  ?task a c:Task ; c:status "open" ; c:description ?text .
  FILTER NOT EXISTS { ?task a c:MergeDelegation }  # 代理マージは q10 で別に出す
  OPTIONAL { ?task c:assignedTo ?agent . ?agent c:agentName ?agentName }
  OPTIONAL { ?task c:forApp ?app }
  OPTIONAL { ?task c:forSubmission ?sub }
  OPTIONAL { ?task c:dueAt ?due }
  OPTIONAL { ?task c:hasSource ?src . ?src rdfs:label ?source }
}
GROUP BY ?task ?text ?agentName ?app ?sub ?due
