PREFIX c: <https://geo-campaign-2026.example/ontology#>
PREFIX id: <https://geo-campaign-2026.example/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Q4 総司令官の判断待ち。人間の関門（HumanGate）の未決。
SELECT ?decision ?type ?label ?status ?due (SAMPLE(?s) AS ?sub) (SAMPLE(?source) AS ?firstSource)
WHERE {
  ?decision a ?type ; rdfs:label ?label ; c:status ?status .
  ?type rdfs:subClassOf* c:HumanGate .
  FILTER(STRSTARTS(?status, "未決"))
  OPTIONAL { ?decision c:dueAt ?due }
  OPTIONAL { ?decision c:forSubmission ?s }
  OPTIONAL { ?decision c:hasSource ?src . ?src rdfs:label ?source }
}
GROUP BY ?decision ?type ?label ?status ?due
ORDER BY ?due ?label
