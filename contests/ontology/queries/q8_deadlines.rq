PREFIX c: <https://geo-campaign-2026.example/ontology#>
PREFIX id: <https://geo-campaign-2026.example/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Q8 応募ごとの締切（部門があれば部門の締切、なければコンペの締切。済みの締切は除く）。
SELECT ?sub ?label ?at
WHERE {
  ?sub a c:Submission ; c:toContest ?c .
  OPTIONAL { ?sub c:toDivision ?d }
  BIND(COALESCE(?d, ?c) AS ?t)
  ?t c:hasDeadline ?dl . ?dl c:dueAt ?at ; c:description ?label .
  FILTER NOT EXISTS { ?dl c:doneAt ?x }
}
ORDER BY ?sub ?at
