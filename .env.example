# 環境変数の雛形。値は入れずにコミットする。
# 使い方: このファイルを .env にコピーし、.env にだけ値を書く（.env は .gitignore 済み。コミットしない）。
#   cp .env.example .env

# 不動産情報ライブラリ（国土交通省）API のキー
# 使う処理: contests/dashboard/src/apps/biz-realestate/fetch-reinfolib.ts
# 実行（contests/dashboard で）:
#   node --env-file=../../.env src/apps/biz-realestate/fetch-reinfolib.ts
REINFOLIB_API_KEY=

# 任意: API の接続先。通常は空のまま（空なら https://www.reinfolib.mlit.go.jp/ex-api/external/ を使う）
# REINFOLIB_BASE_URL=

# 公共交通オープンデータセンター（ODPT）のアクセストークン（開発者サイトで発行）
# API ではクエリ引数 acl:consumerKey として渡す。公開ファイル（web/）やログには書かない
# 使う処理: 未実装（contests/odpt-2026/app は現在キー不要の公開APIのみ使用）
ODPT_ACCESS_TOKEN=
