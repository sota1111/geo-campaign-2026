{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_dangerous.py\"" }
        ]
      }
    ]
  }
}
